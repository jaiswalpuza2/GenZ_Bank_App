# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
# backend/node_modules/ contains a hand-authored @appdeploy/sdk type stub and
# must NOT be gitignored — it is committed source, not a generated artifact.
# Exclude everything else that npm might place there:
backend/node_modules/!(@appdeploy)/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/

# ── Environment files — never commit real credentials ─────────────────────
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local

# ── Editor directories and files ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Coverage ──────────────────────────────────────────────────────────────────
coverage/

# ── Local database files ──────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
