# GenZ Bank — Environment variable reference
# Copy this file to .env and fill in real values for your environment.
# Never commit .env to source control.
#
# Variables prefixed with VITE_ are embedded into the frontend bundle at build
# time and will be visible in the browser. Only use VITE_ for public values.
# All other variables are backend-only and must not be exposed to the browser.

# ── AppDeploy platform (required for full functionality) ──────────────────────
# These are injected automatically when deployed on the AppDeploy platform.
# You do not set them manually for AppDeploy deployments.
# APPDEPLOY_PROJECT_ID=your-project-id-here
# APPDEPLOY_API_KEY=your-api-key-here

# ── Frontend: Vite build overrides (optional) ─────────────────────────────────
# Uncomment to enable verbose API error output in the browser during development.
# VITE_DEBUG_API=false

# ── Frontend: AppDeploy build pipeline overrides (optional) ──────────────────
# Override the output directory used by the AppDeploy build pipeline.
# Leave unset for standard local builds (output goes to frontend/dist/).
# APPDEPLOY_VITE_OUT_DIR=dist

# ── Backend: Server configuration (not applicable — AppDeploy managed) ────────
# The backend runs as a serverless function on the AppDeploy platform.
# No PORT or HOST variables are required.
