{
  "name": "genz-bank",
  "private": true,
  "version": "1.0.0",
  "description": "GenZ Bank — Banking at Your Speed. Monorepo root for the frontend and backend workspaces.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "typecheck": "npm run typecheck --workspace=frontend && npm run typecheck --workspace=backend",
    "typecheck:frontend": "npm run typecheck --workspace=frontend",
    "typecheck:backend": "npm run typecheck --workspace=backend"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
