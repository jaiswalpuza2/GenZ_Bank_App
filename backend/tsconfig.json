{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    // Never emit — AppDeploy compiles backend TypeScript directly at deploy time.
    "noEmit": true,
    // Skip checking declaration files inside node_modules.
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": ["src"]
}
